{
  "$schema": "../../../schemas/ingestion/v2/storage.schema.json",
  "schema_version": 1,
  "artifacts": {
    "provider": "local",
    "run_directory": "../../../runs"
  },
  "graph": {
    "provider": "neo4j",
    "publish_documents": true,
    "publish_requirements": true,
    "publish_code": true,
    "publish_confirmed_mappings": true
  },
  "vector": {
    "provider": "qdrant",
    "publish_chunks": true
  },
  "candidates": {
    "directory": "../../../artifacts/mapping-candidates"
  }
}
