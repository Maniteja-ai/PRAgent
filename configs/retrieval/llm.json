{
  "$schema": "../../schemas/retrieval/retrieval.schema.json",
  "candidate_limit": 10,
  "reranker": {
    "provider": "gemini",
    "options": {
      "model": "gemini-3.5-flash-lite",
      "requests_per_minute": 5,
      "timeout_seconds": 45,
      "max_retries": 1,
      "max_output_tokens": 6000,
      "max_input_chars": 120000,
      "api_key_env": "ENCODER_API_KEY",
      "base_url": null
    }
  },
  "selector": {
    "provider": "score_threshold",
    "options": {
      "score_kind": "gemini-relevance-v1",
      "min_score": 3,
      "max_results": 5,
      "deduplicate_text": true
    }
  }
}
