{
  "$defs": {
    "StageConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "provider"
      ],
      "title": "StageConfig",
      "type": "object"
    },
    "reranker_cross_encoder_options": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "description": "Hugging Face sequence-classification model with one logit.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "revision": {
          "description": "Immutable model and tokenizer commit SHA.",
          "pattern": "^[a-f0-9]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "cache_directory": {
          "default": ".model-cache",
          "minLength": 1,
          "title": "Cache Directory",
          "type": "string"
        },
        "local_files_only": {
          "default": false,
          "description": "Use True after downloading the pinned model.",
          "title": "Local Files Only",
          "type": "boolean"
        },
        "batch_size": {
          "default": 8,
          "maximum": 64,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "max_length": {
          "default": 512,
          "description": "Query, passage window and special tokens.",
          "maximum": 4096,
          "minimum": 64,
          "title": "Max Length",
          "type": "integer"
        },
        "max_query_tokens": {
          "default": 128,
          "description": "Longer queries fail without truncation.",
          "maximum": 512,
          "minimum": 1,
          "title": "Max Query Tokens",
          "type": "integer"
        },
        "overlap_tokens": {
          "default": 64,
          "maximum": 256,
          "minimum": 0,
          "title": "Overlap Tokens",
          "type": "integer"
        },
        "max_windows": {
          "default": 256,
          "description": "Total windows per request; overflow fails.",
          "maximum": 2048,
          "minimum": 1,
          "title": "Max Windows",
          "type": "integer"
        },
        "max_input_chars": {
          "default": 120000,
          "maximum": 500000,
          "minimum": 1000,
          "title": "Max Input Chars",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "revision"
      ],
      "title": "CrossEncoderOptions",
      "type": "object"
    },
    "reranker_gemini_options": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Environment variable NAME, never the API-key value. Explicit names never fall back.",
          "title": "Api Key Env"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider API endpoint; null uses its SDK default.",
          "title": "Base Url"
        },
        "requests_per_minute": {
          "default": 5,
          "maximum": 1000,
          "minimum": 1,
          "title": "Requests Per Minute",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 45,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_retries": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 6000,
          "maximum": 16000,
          "minimum": 512,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_input_chars": {
          "default": 120000,
          "description": "Fail rather than silently truncate passage evidence.",
          "maximum": 500000,
          "minimum": 1000,
          "title": "Max Input Chars",
          "type": "integer"
        },
        "thinking_level": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "low",
          "description": "Set null for Gemini models that do not support thinking_level.",
          "title": "Thinking Level"
        }
      },
      "required": [
        "model"
      ],
      "title": "GeminiRerankerOptions",
      "type": "object"
    },
    "reranker_identity_options": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyOptions",
      "type": "object"
    },
    "reranker_openai_compatible_options": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "default": "ENCODER_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        },
        "base_url": {
          "description": "Chat Completions API base URL, usually ending in /v1.",
          "title": "Base Url",
          "type": "string"
        },
        "requests_per_minute": {
          "default": 5,
          "maximum": 1000,
          "minimum": 1,
          "title": "Requests Per Minute",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 45,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_retries": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 6000,
          "maximum": 16000,
          "minimum": 512,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_input_chars": {
          "default": 120000,
          "description": "Fail rather than silently truncate passage evidence.",
          "maximum": 500000,
          "minimum": 1000,
          "title": "Max Input Chars",
          "type": "integer"
        },
        "structured_output": {
          "default": "json_schema",
          "description": "Choose a JSON mode supported by this provider/model. No automatic fallback.",
          "enum": [
            "json_schema",
            "json_mode"
          ],
          "title": "Structured Output",
          "type": "string"
        }
      },
      "required": [
        "model",
        "base_url"
      ],
      "title": "CompatibleLLMOptions",
      "type": "object"
    },
    "selector_score_threshold_options": {
      "additionalProperties": false,
      "properties": {
        "max_results": {
          "default": 5,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Results",
          "type": "integer"
        },
        "score_kind": {
          "description": "Must match the reranker's score scale exactly.",
          "minLength": 1,
          "title": "Score Kind",
          "type": "string"
        },
        "min_score": {
          "description": "Inclusive relevance cutoff; not a probability.",
          "title": "Min Score",
          "type": "number"
        },
        "deduplicate_text": {
          "default": true,
          "description": "Remove exact duplicate text after ranking.",
          "title": "Deduplicate Text",
          "type": "boolean"
        }
      },
      "required": [
        "score_kind",
        "min_score"
      ],
      "title": "ThresholdOptions",
      "type": "object"
    },
    "selector_top_k_options": {
      "additionalProperties": false,
      "properties": {
        "max_results": {
          "default": 5,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Results",
          "type": "integer"
        }
      },
      "title": "TopKOptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "candidate_limit": {
      "default": 5,
      "description": "Vector candidates; increase explicitly when reranking.",
      "maximum": 100,
      "minimum": 1,
      "title": "Candidate Limit",
      "type": "integer"
    },
    "reranker": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "cross_encoder",
                "gemini",
                "identity",
                "openai_compatible"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\s*[A-Za-z0-9_-]+\\s*$"
            }
          ]
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "provider"
      ],
      "title": "StageConfig",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "pattern": "^\\s*[cC][rR][oO][sS][sS]_[eE][nN][cC][oO][dD][eE][rR]\\s*$"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/reranker_cross_encoder_options"
              }
            },
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "pattern": "^\\s*[gG][eE][mM][iI][nN][iI]\\s*$"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/reranker_gemini_options"
              }
            },
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "pattern": "^\\s*[iI][dD][eE][nN][tT][iI][tT][yY]\\s*$"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/reranker_identity_options"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "pattern": "^\\s*[oO][pP][eE][nN][aA][iI]_[cC][oO][mM][pP][aA][tT][iI][bB][lL][eE]\\s*$"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/reranker_openai_compatible_options"
              }
            },
            "required": [
              "options"
            ]
          }
        }
      ]
    },
    "selector": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "score_threshold",
                "top_k"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\s*[A-Za-z0-9_-]+\\s*$"
            }
          ]
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "provider"
      ],
      "title": "StageConfig",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "pattern": "^\\s*[sS][cC][oO][rR][eE]_[tT][hH][rR][eE][sS][hH][oO][lL][dD]\\s*$"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/selector_score_threshold_options"
              }
            },
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "pattern": "^\\s*[tT][oO][pP]_[kK]\\s*$"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/selector_top_k_options"
              }
            }
          }
        }
      ]
    }
  },
  "title": "Retrieval stages",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The retriever uses the selected ingestion run. Replace stages through registered providers."
}
