{
  "$defs": {
    "GraphScope": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "max_dependency_hops": {
          "default": 3,
          "maximum": 8,
          "minimum": 0,
          "title": "Max Dependency Hops",
          "type": "integer"
        },
        "mapping_statuses": {
          "default": [
            "CONFIRMED"
          ],
          "items": {
            "const": "CONFIRMED",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Mapping Statuses",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "revision"
      ],
      "title": "GraphScope",
      "type": "object"
    },
    "SymbolLookup": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "SymbolLookup",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "id": {
      "default": "",
      "title": "Id",
      "type": "string"
    },
    "fixture_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture Id"
    },
    "operation": {
      "const": "impact_neighborhood",
      "default": "impact_neighborhood",
      "title": "Operation",
      "type": "string"
    },
    "changed_symbol_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Changed Symbol Ids",
      "type": "array"
    },
    "changed_files": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Changed Files",
      "type": "array"
    },
    "symbol_lookup": {
      "anyOf": [
        {
          "$ref": "#/$defs/SymbolLookup"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scope": {
      "$ref": "#/$defs/GraphScope"
    }
  },
  "required": [
    "scope"
  ],
  "title": "ImpactQuery",
  "type": "object"
}
