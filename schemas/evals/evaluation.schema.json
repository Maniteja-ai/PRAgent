{
  "$defs": {
    "Gates": {
      "additionalProperties": false,
      "properties": {
        "precision_min": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision Min"
        },
        "recall_min": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recall Min"
        }
      },
      "title": "Gates",
      "type": "object"
    },
    "PredictionFields": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "default": "id",
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "items": {
          "default": "retrieved_ids",
          "description": "Dotted path to the result list; rank order is preserved.",
          "minLength": 1,
          "title": "Items",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For object results, the dotted ID path inside each item.",
          "title": "Item Id"
        },
        "execution_status": {
          "default": "execution_status",
          "description": "OK, ERROR or MISSING; absent means OK.",
          "minLength": 1,
          "title": "Execution Status",
          "type": "string"
        },
        "result_status": {
          "default": "status",
          "description": "Optional application status, distinct from execution success.",
          "minLength": 1,
          "title": "Result Status",
          "type": "string"
        }
      },
      "title": "PredictionFields",
      "type": "object"
    },
    "ReferenceFields": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "default": "id",
          "description": "Dotted field path containing the case ID.",
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "inputs": {
          "default": "input",
          "description": "Input-only object passed to a Python adapter.",
          "minLength": 1,
          "title": "Inputs",
          "type": "string"
        },
        "expected_ids": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "reference.expected_ids",
          "description": "Expected relevant IDs.",
          "title": "Expected Ids"
        },
        "relevance_grades": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Alternative: object mapping candidate IDs to grades.",
          "title": "Relevance Grades"
        },
        "relevant_grade": {
          "default": 2,
          "description": "Minimum grade considered relevant.",
          "minimum": 1,
          "title": "Relevant Grade",
          "type": "integer"
        },
        "candidate_universe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional exhaustive list of judged candidate IDs.",
          "title": "Candidate Universe"
        },
        "evidence_units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional list of required evidence units.",
          "title": "Evidence Units"
        },
        "unit_alternatives": {
          "default": "acceptable_passage_ids",
          "minLength": 1,
          "title": "Unit Alternatives",
          "type": "string"
        },
        "expected_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional expected application status, such as UNMAPPED.",
          "title": "Expected Status"
        },
        "approval": {
          "default": "review.approved",
          "description": "True only after independent review.",
          "minLength": 1,
          "title": "Approval",
          "type": "string"
        },
        "complete": {
          "default": false,
          "description": "Declare whether reference labels are exhaustive within the case scope.",
          "title": "Complete",
          "type": "boolean"
        }
      },
      "title": "ReferenceFields",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "dataset": {
      "description": "JSONL reference cases; relative paths resolve beside this config.",
      "format": "path",
      "title": "Dataset",
      "type": "string"
    },
    "predictions": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "JSONL saved outputs; omit only when supplying a Python adapter.",
      "title": "Predictions"
    },
    "output_directory": {
      "default": "evaluation-results",
      "format": "path",
      "title": "Output Directory",
      "type": "string"
    },
    "task": {
      "default": "ranked_retrieval",
      "enum": [
        "ranked_retrieval",
        "set_retrieval"
      ],
      "title": "Task",
      "type": "string"
    },
    "k": {
      "default": 5,
      "description": "Top-k cutoff for ranked retrieval; set retrieval uses every returned ID.",
      "maximum": 1000,
      "minimum": 1,
      "title": "K",
      "type": "integer"
    },
    "mode": {
      "default": "development",
      "enum": [
        "development",
        "release"
      ],
      "title": "Mode",
      "type": "string"
    },
    "reference": {
      "$ref": "#/$defs/ReferenceFields"
    },
    "prediction": {
      "$ref": "#/$defs/PredictionFields"
    },
    "gates": {
      "$ref": "#/$defs/Gates"
    }
  },
  "required": [
    "dataset"
  ],
  "title": "EvaluationConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
