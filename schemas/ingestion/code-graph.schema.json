{
  "$defs": {
    "StageConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "provider"
      ],
      "title": "StageConfig",
      "type": "object"
    },
    "analyzer_typescript_options": {
      "additionalProperties": false,
      "properties": {
        "tsconfig": {
          "default": "tsconfig.json",
          "title": "Tsconfig",
          "type": "string"
        },
        "source_prefixes": {
          "default": [
            "src/"
          ],
          "items": {
            "type": "string"
          },
          "title": "Source Prefixes",
          "type": "array"
        },
        "max_files": {
          "default": 2000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_bytes": {
          "default": 30000000,
          "maximum": 100000000,
          "minimum": 1000,
          "title": "Max Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 90,
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "TypeScriptOptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "repository_path": {
      "description": "Local Git checkout; resolved relative to this JSON.",
      "minLength": 1,
      "title": "Repository Path",
      "type": "string"
    },
    "revision": {
      "description": "Full pinned commit SHA; dirty worktree changes are excluded.",
      "pattern": "^[a-f0-9]{40}$",
      "title": "Revision",
      "type": "string"
    },
    "analyzer": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "typescript"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\s*[A-Za-z0-9_-]+\\s*$"
            }
          ]
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "provider"
      ],
      "title": "StageConfig",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "pattern": "^\\s*[tT][yY][pP][eE][sS][cC][rR][iI][pP][tT]\\s*$"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/analyzer_typescript_options"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "project_id",
    "repository_path",
    "revision"
  ],
  "title": "Pinned code graph ingestion",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
