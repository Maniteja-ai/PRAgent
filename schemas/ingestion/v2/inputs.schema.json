{
  "$defs": {
    "CodeInput": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "repository_path": {
          "title": "Repository Path",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "repository_path",
        "revision"
      ],
      "title": "CodeInput",
      "type": "object"
    },
    "DocumentInputs": {
      "additionalProperties": false,
      "properties": {
        "allowed_hosts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetadataConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DocumentInputs",
      "type": "object"
    },
    "MetadataConfig": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "description": "Definitions for custom source metadata.",
          "items": {
            "$ref": "#/$defs/MetadataField"
          },
          "title": "Fields",
          "type": "array"
        },
        "defaults": {
          "additionalProperties": true,
          "description": "Shared values inherited by every source.",
          "title": "Defaults",
          "type": "object"
        }
      },
      "title": "MetadataConfig",
      "type": "object"
    },
    "MetadataField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "JSON key for this custom field.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "description": "Readable label for this metadata field.",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Help text explaining the field.",
          "title": "Description",
          "type": "string"
        },
        "type": {
          "default": "string",
          "description": "Value type. String choices supply JSON editor suggestions.",
          "enum": [
            "string",
            "number",
            "boolean",
            "string_list"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": false,
          "description": "Every source must supply this field or inherit a default.",
          "title": "Required",
          "type": "boolean"
        },
        "choices": {
          "description": "Optional allowed values for a string field.",
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "name",
        "title"
      ],
      "title": "MetadataField",
      "type": "object"
    },
    "Repository": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "baseline_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Baseline Commit",
          "type": "string"
        },
        "code_roots": {
          "items": {
            "type": "string"
          },
          "title": "Code Roots",
          "type": "array"
        }
      },
      "required": [
        "url",
        "baseline_commit"
      ],
      "title": "Repository",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string"
        },
        "loader": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loader"
        },
        "parser": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object"
        },
        "authority": {
          "enum": [
            "frontend_spec",
            "backend_contract",
            "api_contract"
          ],
          "title": "Authority",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Custom values defined by the project's metadata schema.",
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "authority",
        "version",
        "scope"
      ],
      "title": "Source",
      "type": "object"
    },
    "UiInput": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "seed_paths": {
          "default": [
            "/"
          ],
          "items": {
            "type": "string"
          },
          "title": "Seed Paths",
          "type": "array"
        },
        "allowed_hosts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        }
      },
      "required": [
        "base_url"
      ],
      "title": "UiInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "repository": {
      "$ref": "#/$defs/Repository"
    },
    "baseline_url": {
      "title": "Baseline Url",
      "type": "string"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Scope",
      "type": "array"
    },
    "excluded_inputs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Excluded Inputs",
      "type": "array"
    },
    "documents": {
      "$ref": "#/$defs/DocumentInputs"
    },
    "code": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodeInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ui": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "repository",
    "baseline_url",
    "scope",
    "documents"
  ],
  "title": "InputConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
