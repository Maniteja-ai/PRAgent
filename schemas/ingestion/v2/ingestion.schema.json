{
  "$defs": {
    "ConfigFileReferences": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "default": "inputs.json",
          "title": "Inputs",
          "type": "string"
        },
        "processing": {
          "default": "processing.json",
          "title": "Processing",
          "type": "string"
        },
        "storage": {
          "default": "storage.json",
          "title": "Storage",
          "type": "string"
        },
        "runtime": {
          "default": "runtime.json",
          "title": "Runtime",
          "type": "string"
        },
        "evaluation": {
          "default": "evaluation.json",
          "title": "Evaluation",
          "type": "string"
        }
      },
      "title": "ConfigFileReferences",
      "type": "object"
    },
    "ProjectIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProjectIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "project": {
      "$ref": "#/$defs/ProjectIdentity"
    },
    "config": {
      "$ref": "#/$defs/ConfigFileReferences"
    }
  },
  "required": [
    "project"
  ],
  "title": "IngestionEntry",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
