{
  "$defs": {
    "FailurePolicy": {
      "additionalProperties": false,
      "properties": {
        "source_error": {
          "default": "continue",
          "enum": [
            "continue",
            "stop"
          ],
          "title": "Source Error",
          "type": "string"
        }
      },
      "title": "FailurePolicy",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 2,
          "maximum": 5,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "TimeoutPolicy": {
      "additionalProperties": false,
      "properties": {
        "run_seconds": {
          "default": 1800,
          "maximum": 86400,
          "minimum": 1,
          "title": "Run Seconds",
          "type": "integer"
        },
        "model_seconds": {
          "default": 45,
          "maximum": 600,
          "minimum": 1,
          "title": "Model Seconds",
          "type": "integer"
        }
      },
      "title": "TimeoutPolicy",
      "type": "object"
    },
    "WorkLimits": {
      "additionalProperties": false,
      "properties": {
        "documents": {
          "default": 1000,
          "minimum": 1,
          "title": "Documents",
          "type": "integer"
        },
        "code_files": {
          "default": 10000,
          "minimum": 1,
          "title": "Code Files",
          "type": "integer"
        },
        "ui_pages": {
          "default": 50,
          "minimum": 1,
          "title": "Ui Pages",
          "type": "integer"
        },
        "mapping_candidates": {
          "default": 10000,
          "minimum": 1,
          "title": "Mapping Candidates",
          "type": "integer"
        }
      },
      "title": "WorkLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "retries": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "timeouts": {
      "$ref": "#/$defs/TimeoutPolicy"
    },
    "limits": {
      "$ref": "#/$defs/WorkLimits"
    },
    "failures": {
      "$ref": "#/$defs/FailurePolicy"
    }
  },
  "title": "RuntimeConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
