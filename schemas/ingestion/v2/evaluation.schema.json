{
  "$defs": {
    "MetricConfig": {
      "additionalProperties": false,
      "properties": {
        "requirement_grounding": {
          "default": true,
          "title": "Requirement Grounding",
          "type": "boolean"
        },
        "vector_retrieval": {
          "default": true,
          "title": "Vector Retrieval",
          "type": "boolean"
        },
        "graph_retrieval": {
          "default": true,
          "title": "Graph Retrieval",
          "type": "boolean"
        },
        "mapping_precision": {
          "default": true,
          "title": "Mapping Precision",
          "type": "boolean"
        },
        "mapping_recall": {
          "default": true,
          "title": "Mapping Recall",
          "type": "boolean"
        }
      },
      "title": "MetricConfig",
      "type": "object"
    },
    "RecordingConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "directory": {
          "default": "../../../artifacts/ingestion-observations",
          "title": "Directory",
          "type": "string"
        },
        "include_payloads": {
          "default": false,
          "title": "Include Payloads",
          "type": "boolean"
        }
      },
      "title": "RecordingConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "recording": {
      "$ref": "#/$defs/RecordingConfig"
    },
    "golden_dataset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Golden Dataset"
    },
    "metrics": {
      "$ref": "#/$defs/MetricConfig"
    }
  },
  "title": "EvaluationConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
