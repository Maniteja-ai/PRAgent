{
  "$defs": {
    "EmbeddingConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "gemini",
                "openai"
              ]
            },
            {
              "type": "string"
            }
          ],
          "description": "Choose a registered component. Names ignore case and surrounding spaces. Custom names must be registered in Python; unknown names fail before ingestion."
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string",
          "description": "Exact embedding model ID. Gemini currently supports gemini-embedding-2."
        },
        "dimensions": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Dimensions",
          "type": "integer",
          "description": "Vector size supported by the selected embedding model."
        },
        "requests_per_minute": {
          "default": 10,
          "maximum": 10000,
          "minimum": 0,
          "title": "Requests Per Minute",
          "type": "integer",
          "description": "Space embedding requests; 0 disables pacing."
        },
        "options": {
          "additionalProperties": true,
          "description": "Options declared by the selected provider implementation.",
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "provider",
        "model",
        "dimensions"
      ],
      "title": "EmbeddingConfig",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "gemini"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/embeddings_gemini_options"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "openai"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/embeddings_openai_options"
              }
            }
          }
        }
      ]
    },
    "ExtractionConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "gemini",
                "gemini_interactions",
                "openai"
              ]
            },
            {
              "type": "string"
            }
          ],
          "description": "Choose a registered component. Names ignore case and surrounding spaces. Custom names must be registered in Python; unknown names fail before ingestion."
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string",
          "description": "Exact model ID supported by your provider account. Configuration validation does not verify account access."
        },
        "max_output_tokens": {
          "default": 6000,
          "maximum": 32000,
          "minimum": 256,
          "title": "Max Output Tokens",
          "type": "integer",
          "description": "Maximum generated tokens per extraction request."
        },
        "thinking_level": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Level",
          "description": "Optional Gemini reasoning setting. Leave unset for other providers."
        },
        "requests_per_minute": {
          "default": 10,
          "maximum": 10000,
          "minimum": 0,
          "title": "Requests Per Minute",
          "type": "integer",
          "description": "Space application requests; 0 disables pacing. SDK retries and account quotas are separate."
        },
        "options": {
          "additionalProperties": true,
          "description": "Options declared by the selected provider implementation.",
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "ExtractionConfig",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "gemini"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/extractors_gemini_options"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "gemini_interactions"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/extractors_gemini_interactions_options"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "openai"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/extractors_openai_options"
              }
            }
          }
        }
      ]
    },
    "MetadataConfig": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "description": "Definitions for custom source metadata.",
          "items": {
            "$ref": "#/$defs/MetadataField"
          },
          "title": "Fields",
          "type": "array"
        },
        "defaults": {
          "additionalProperties": true,
          "description": "Shared values inherited by every source.",
          "title": "Defaults",
          "type": "object"
        }
      },
      "title": "MetadataConfig",
      "type": "object"
    },
    "MetadataField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "JSON key for this custom field.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "description": "Readable label for this metadata field.",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Help text explaining the field.",
          "title": "Description",
          "type": "string"
        },
        "type": {
          "default": "string",
          "description": "Value type. String choices supply JSON editor suggestions.",
          "enum": [
            "string",
            "number",
            "boolean",
            "string_list"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": false,
          "description": "Every source must supply this field or inherit a default.",
          "title": "Required",
          "type": "boolean"
        },
        "choices": {
          "description": "Optional allowed values for a string field.",
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "name",
        "title"
      ],
      "title": "MetadataField",
      "type": "object"
    },
    "Repository": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string",
          "description": "Repository URL recorded for provenance; this stage does not ingest source code."
        },
        "baseline_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Baseline Commit",
          "type": "string",
          "description": "Full 40-character commit SHA for the baseline application."
        },
        "code_roots": {
          "items": {
            "type": "string"
          },
          "title": "Code Roots",
          "type": "array",
          "description": "Repository-relative code directories for subsequent code analysis."
        }
      },
      "required": [
        "url",
        "baseline_commit"
      ],
      "title": "Repository",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string",
          "description": "Unique source key used in artifacts and citations."
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string",
          "description": "HTTPS URL or a local path relative to the project JSON directory."
        },
        "loader": {
          "default": null,
          "title": "Loader",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "github_file",
                "local_file",
                "web"
              ]
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Choose a registered component. Names ignore case and surrounding spaces. Custom names must be registered in Python; unknown names fail before ingestion."
        },
        "parser": {
          "default": null,
          "title": "Parser",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "html",
                "markdown"
              ]
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Choose a registered component. Names ignore case and surrounding spaces. Custom names must be registered in Python; unknown names fail before ingestion."
        },
        "format": {
          "default": null,
          "title": "Format",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "html",
                "markdown"
              ]
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Choose a registered component. Names ignore case and surrounding spaces. Custom names must be registered in Python; unknown names fail before ingestion."
        },
        "options": {
          "additionalProperties": true,
          "title": "Options",
          "type": "object",
          "description": "Fields declared by the selected loader implementation."
        },
        "authority": {
          "enum": [
            "frontend_spec",
            "backend_contract",
            "api_contract"
          ],
          "title": "Authority",
          "type": "string",
          "description": "What this document can establish: frontend behaviour, backend rules or an API contract."
        },
        "version": {
          "title": "Version",
          "type": "string",
          "description": "Pinned commit/version, or an explicit label for unpinned online documentation."
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array",
          "description": "Source topic labels retained as provenance."
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Custom values defined by the project's metadata schema.",
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "authority",
        "version",
        "scope"
      ],
      "title": "Source",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "loader": {
                "const": "github_file"
              }
            },
            "required": [
              "loader"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/loaders_github_file_options"
              }
            },
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "loader": {
                "const": "local_file"
              }
            },
            "required": [
              "loader"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/loaders_local_file_options"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "loader": {
                "const": "web"
              }
            },
            "required": [
              "loader"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/loaders_web_options"
              }
            }
          }
        }
      ]
    },
    "StorageConfig": {
      "additionalProperties": false,
      "properties": {
        "graph": {
          "default": "neo4j",
          "title": "Graph",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "neo4j"
              ]
            },
            {
              "type": "string"
            }
          ],
          "description": "Choose a registered component. Names ignore case and surrounding spaces. Custom names must be registered in Python; unknown names fail before ingestion."
        },
        "vector": {
          "default": "qdrant",
          "title": "Vector",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "qdrant"
              ]
            },
            {
              "type": "string"
            }
          ],
          "description": "Choose a registered component. Names ignore case and surrounding spaces. Custom names must be registered in Python; unknown names fail before ingestion."
        },
        "artifacts": {
          "default": "local",
          "title": "Artifacts",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "local"
              ]
            },
            {
              "type": "string"
            }
          ],
          "description": "Choose a registered component. Names ignore case and surrounding spaces. Custom names must be registered in Python; unknown names fail before ingestion."
        }
      },
      "title": "StorageConfig",
      "type": "object"
    },
    "loaders_github_file_options": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "description": "Public GitHub owner/repository, for example saleor/storefront.",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Full commit SHA. If omitted, the source version is used.",
          "title": "Pinned commit"
        },
        "path": {
          "description": "Repository-relative file path, for example README.md.",
          "minLength": 1,
          "title": "File path",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "path"
      ],
      "title": "GitHubOptions",
      "type": "object"
    },
    "loaders_local_file_options": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyOptions",
      "type": "object"
    },
    "loaders_web_options": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyOptions",
      "type": "object"
    },
    "extractors_gemini_options": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyOptions",
      "type": "object"
    },
    "extractors_gemini_interactions_options": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyOptions",
      "type": "object"
    },
    "extractors_openai_options": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyOptions",
      "type": "object"
    },
    "embeddings_gemini_options": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyOptions",
      "type": "object"
    },
    "embeddings_openai_options": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyOptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "project_id": {
      "pattern": "^[a-z0-9_-]+$",
      "title": "Project Id",
      "type": "string",
      "description": "Unique project key. Use lowercase letters, digits, underscores or hyphens."
    },
    "name": {
      "title": "Name",
      "type": "string",
      "description": "A friendly name for this application."
    },
    "repository": {
      "$ref": "#/$defs/Repository"
    },
    "baseline_url": {
      "title": "Baseline Url",
      "type": "string",
      "description": "Deployed baseline application. Collection does not browse this URL."
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Scope",
      "type": "array",
      "description": "Product behaviours to focus on when extracting requirements."
    },
    "allowed_document_hosts": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Document Hosts",
      "type": "array",
      "description": "Exact HTTPS hostnames permitted for web documents and redirects."
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array",
      "description": "Explicit inputs to ingest. The library does not recursively crawl a website."
    },
    "max_chunk_chars": {
      "default": 8000,
      "maximum": 32000,
      "minimum": 1000,
      "title": "Max Chunk Chars",
      "type": "integer",
      "description": "Target character limit per section. Oversized indivisible blocks are flagged."
    },
    "excluded_inputs": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Inputs",
      "type": "array",
      "description": "Recorded exclusions. These labels are provenance notes, not automatic content filters."
    },
    "chunker": {
      "default": "section",
      "title": "Chunker",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "section"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "Choose a registered component. Names ignore case and surrounding spaces. Custom names must be registered in Python; unknown names fail before ingestion."
    },
    "extractor": {
      "default": "langchain",
      "title": "Extractor",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "langchain",
            "openai"
          ]
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/ExtractionConfig"
        }
      ],
      "description": "Choose a registered component. Names ignore case and surrounding spaces. Custom names must be registered in Python; unknown names fail before ingestion."
    },
    "embedding_provider": {
      "default": "openai",
      "title": "Embedding Provider",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "openai"
          ]
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/EmbeddingConfig"
        }
      ],
      "description": "Choose a registered component. Names ignore case and surrounding spaces. Custom names must be registered in Python; unknown names fail before ingestion."
    },
    "storage": {
      "$ref": "#/$defs/StorageConfig"
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetadataConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Define custom field types, descriptions and shared defaults, then set source overrides."
    }
  },
  "required": [
    "project_id",
    "name",
    "repository",
    "baseline_url",
    "scope",
    "sources"
  ],
  "title": "Trace Impact ingestion project",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Select components from suggestions, or name a custom registered implementation.",
  "x-components": {
    "code_analyzers": {
      "typescript": {
        "title": "TypeScript compiler",
        "description": "Analyze immutable Git sources without executing the repository.",
        "options_schema": {
          "additionalProperties": false,
          "properties": {
            "tsconfig": {
              "default": "tsconfig.json",
              "title": "Tsconfig",
              "type": "string"
            },
            "source_prefixes": {
              "default": [
                "src/"
              ],
              "items": {
                "type": "string"
              },
              "title": "Source Prefixes",
              "type": "array"
            },
            "max_files": {
              "default": 2000,
              "maximum": 10000,
              "minimum": 1,
              "title": "Max Files",
              "type": "integer"
            },
            "max_bytes": {
              "default": 30000000,
              "maximum": 100000000,
              "minimum": 1000,
              "title": "Max Bytes",
              "type": "integer"
            },
            "timeout_seconds": {
              "default": 90,
              "maximum": 300,
              "minimum": 1,
              "title": "Timeout Seconds",
              "type": "integer"
            }
          },
          "title": "TypeScriptOptions",
          "type": "object"
        }
      }
    },
    "loaders": {
      "github_file": {
        "title": "GitHub file",
        "description": "Read a public repository file at a pinned commit.",
        "options_schema": {
          "additionalProperties": false,
          "properties": {
            "repository": {
              "description": "Public GitHub owner/repository, for example saleor/storefront.",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
              "title": "Repository",
              "type": "string"
            },
            "revision": {
              "anyOf": [
                {
                  "pattern": "^[a-f0-9]{40}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Full commit SHA. If omitted, the source version is used.",
              "title": "Pinned commit"
            },
            "path": {
              "description": "Repository-relative file path, for example README.md.",
              "minLength": 1,
              "title": "File path",
              "type": "string"
            }
          },
          "required": [
            "repository",
            "path"
          ],
          "title": "GitHubOptions",
          "type": "object"
        }
      },
      "local_file": {
        "title": "Local file",
        "description": "Read a file inside this project's configuration directory.",
        "options_schema": {
          "additionalProperties": false,
          "properties": {},
          "title": "EmptyOptions",
          "type": "object"
        }
      },
      "web": {
        "title": "Website",
        "description": "Read one public HTTPS documentation page.",
        "options_schema": {
          "additionalProperties": false,
          "properties": {},
          "title": "EmptyOptions",
          "type": "object"
        }
      }
    },
    "parsers": {
      "html": {
        "title": "HTML",
        "description": "Extract documentation text from HTML.",
        "options_schema": null
      },
      "markdown": {
        "title": "Markdown",
        "description": "Parse Markdown documents such as README.md.",
        "options_schema": null
      }
    },
    "chunkers": {
      "section": {
        "title": "section",
        "description": "Registered custom implementation; see its plugin documentation.",
        "options_schema": null
      }
    },
    "extractors": {
      "gemini": {
        "title": "Gemini",
        "description": "Model ID and pacing are configured below. Credentials are read from .env.",
        "options_schema": {
          "additionalProperties": false,
          "properties": {},
          "title": "EmptyOptions",
          "type": "object"
        }
      },
      "gemini_interactions": {
        "title": "Gemini Interactions",
        "description": "Model ID and pacing are configured below. Credentials are read from .env.",
        "options_schema": {
          "additionalProperties": false,
          "properties": {},
          "title": "EmptyOptions",
          "type": "object"
        }
      },
      "langchain": {
        "title": "langchain",
        "description": "Registered custom implementation; see its plugin documentation.",
        "options_schema": null
      },
      "openai": {
        "title": "Openai",
        "description": "Model ID and pacing are configured below. Credentials are read from .env.",
        "options_schema": {
          "additionalProperties": false,
          "properties": {},
          "title": "EmptyOptions",
          "type": "object"
        }
      }
    },
    "embeddings": {
      "gemini": {
        "title": "Gemini",
        "description": "Model ID and pacing are configured below. Credentials are read from .env.",
        "options_schema": {
          "additionalProperties": false,
          "properties": {},
          "title": "EmptyOptions",
          "type": "object"
        }
      },
      "openai": {
        "title": "Openai",
        "description": "Model ID and pacing are configured below. Credentials are read from .env.",
        "options_schema": {
          "additionalProperties": false,
          "properties": {},
