{
  "$schema": "../../../schemas/runtime.schema.json",
  "schema_version": 1,
  "calls": {
    "per_tool": 5,
    "total": 30,
    "reasoning_rounds": 10,
    "review_requests": 2,
    "citation_repairs": 1,
    "overrides": {}
  },
  "retries": {
    "attempts": 2,
    "delay_seconds": 1,
    "invalid_model_response": false
  },
  "timeouts": {
    "run_seconds": 900,
    "model_seconds": 45
  },
  "guardrails": {
    "enabled": true,
    "request_sensitive_action": "block",
    "evidence_sensitive_action": "redact",
    "prompt_injection_action": "quarantine",
    "output_sensitive_action": "block",
    "max_findings_per_call": 100
  }
}
