{
  "$schema": "../../schemas/voucher-verification.schema.json",
  "application_file": "../saleor-application.json",
  "state_directory": "../../runs/verification",
  "graphql_url": "https://store-vlrmbn6z.saleor.cloud/graphql/",
  "channel": "default-channel",
  "product_slug": "ascii-tee",
  "variant_name": "S",
  "voucher_code": "TSIGMA10",
  "discount_percent": "10",
  "currency": "USD",
  "total_selector": "article:visible data.text-xl",
  "assertion_timeout_seconds": 30,
  "requirements": [
    {
      "id": "VOUCHER_APPLY_TOTAL",
      "statement": "Applying an eligible voucher updates the checkout backend and displayed total.",
      "environment": "patched",
      "check_names": [
        "Eligible voucher reaches backend",
        "Displayed discounted total and voucher state"
      ]
    },
    {
      "id": "VOUCHER_REMOVE_TOTAL",
      "statement": "Removing an applied voucher restores the original checkout total.",
      "environment": "patched",
      "check_names": ["Remove voucher and restore total"]
    }
  ],
  "limits": {
    "per_agent_tool": 5,
    "total_calls": 25,
    "retry_attempts": 1,
    "max_run_seconds": 600
  }
}
