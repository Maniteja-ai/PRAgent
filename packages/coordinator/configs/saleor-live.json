{
  "$schema": "../schemas/coordinator.schema.json",
  "schema_version": 1,
  "application_config_file": "application/saleor.json",
  "runtime_config_file": "runtime/live-exploration.json",
  "env_file": "../../../.env",
  "model": {
    "provider": "gemini",
    "model": "gemini-3.5-flash-lite",
    "api_key_env": "GEMINI_API_KEY",
    "max_output_tokens": 4000,
    "max_input_chars": 120000
  },
  "response_formatter": {
    "provider": "llm"
  },
  "ui_exploration": {
    "enabled": true,
    "environment": "patched",
    "goal": "Discover a product-to-cart-to-checkout journey and observe the voucher controls. Prefer a product without variant choices when possible. Do not submit an order.",
    "target_controls": [
      "Promo code",
      "Discount code",
      "Voucher code"
    ],
    "max_steps": 4,
    "max_state_visits": 2
  },
  "human_review": {
    "policy": "non_blocking",
    "allow_follow_up_verification": true
  },
  "state_directory": "../runs"
}
