{
  "$schema": "../schemas/coordinator.schema.json",
  "schema_version": 1,
  "application_config_file": "application/saleor-webhook.json",
  "runtime_config_file": "runtime/webhook.json",
  "env_file": "../../../.env",
  "model": {
    "provider": "gemini",
    "model": "gemini-3.5-flash-lite",
    "api_key_env": "GEMINI_API_KEY",
    "max_output_tokens": 4000,
    "max_input_chars": 120000
  },
  "human_review": {
    "policy": "non_blocking"
  },
  "state_directory": "../runs"
}
