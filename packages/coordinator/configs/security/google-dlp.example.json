{
  "provider": {
    "provider": "google_dlp",
    "project_id_env": "GOOGLE_CLOUD_PROJECT",
    "location": "global",
    "info_types": [
      "PERSON_NAME",
      "EMAIL_ADDRESS",
      "PHONE_NUMBER",
      "STREET_ADDRESS",
      "CREDIT_CARD_NUMBER",
      "US_SOCIAL_SECURITY_NUMBER",
      "AUTH_TOKEN",
      "JSON_WEB_TOKEN"
    ],
    "min_likelihood": "POSSIBLE",
    "max_findings": 100,
    "timeout_seconds": 15
  },
  "sensitive_action": "block",
  "scanner_error_action": "block",
  "unsupported_action": "block",
  "max_bytes": 1000000
}
