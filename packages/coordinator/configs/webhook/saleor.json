{
  "$schema": "../../schemas/github-webhook.schema.json",
  "schema_version": 1,
  "webhook_secret_env": "GITHUB_WEBHOOK_SECRET",
  "allowed_repositories": ["Maniteja-ai/storefront"],
  "accepted_actions": ["opened", "reopened", "synchronize", "ready_for_review"],
  "database_file": "../../runs/github-webhook.sqlite",
  "coordinator_config_file": "../saleor-webhook.json",
  "output_directory": "../../artifacts/webhook",
  "project_id": "saleor-storefront",
  "question": "Which UI flows and requirements could this PR affect?",
  "publish": "disabled",
  "github_app": {
    "app_id_env": "GITHUB_APP_ID",
    "private_key_env": "GITHUB_APP_PRIVATE_KEY",
    "private_key_file_env": "GITHUB_APP_PRIVATE_KEY_FILE",
    "api_version": "2026-03-10"
  },
  "max_payload_bytes": 1000000
}
