{
  "$defs": {
    "DeploymentFile": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "attestation_path": {
          "default": "/api/trace-build",
          "title": "Attestation Path",
          "type": "string"
        }
      },
      "required": [
        "url",
        "revision"
      ],
      "title": "DeploymentFile",
      "type": "object"
    },
    "GitHubSource": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "github",
          "default": "github",
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "GitHubSource",
      "type": "object"
    },
    "LocalGitSource": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "local_git",
          "default": "local_git",
          "title": "Provider",
          "type": "string"
        },
        "pull_request": {
          "description": "User-supplied PR label; not verified against GitHub.",
          "exclusiveMinimum": 0,
          "title": "Pull Request",
          "type": "integer"
        },
        "base_revision": {
          "description": "Full commit ID already present in the local repository.",
          "pattern": "^[a-f0-9]{40}$",
          "title": "Base Revision",
          "type": "string"
        },
        "head_revision": {
          "description": "Full commit ID of the proposed change, already present locally.",
          "pattern": "^[a-f0-9]{40}$",
          "title": "Head Revision",
          "type": "string"
        },
        "historical_replay": {
          "default": false,
          "description": "User-supplied replay label; no remote status lookup.",
          "title": "Historical Replay",
          "type": "boolean"
        }
      },
      "required": [
        "pull_request",
        "base_revision",
        "head_revision"
      ],
      "title": "LocalGitSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The only application document a user edits directly.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "title": "Repository",
      "type": "string"
    },
    "repository_path": {
      "minLength": 1,
      "title": "Repository Path",
      "type": "string"
    },
    "change_source": {
      "discriminator": {
        "mapping": {
          "github": "#/$defs/GitHubSource",
          "local_git": "#/$defs/LocalGitSource"
        },
        "propertyName": "provider"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LocalGitSource"
        },
        {
          "$ref": "#/$defs/GitHubSource"
        }
      ],
      "title": "Change Source"
    },
    "graph_config_file": {
      "minLength": 1,
      "title": "Graph Config File",
      "type": "string"
    },
    "retrieval_config_file": {
      "minLength": 1,
      "title": "Retrieval Config File",
      "type": "string"
    },
    "ui_config_file": {
      "minLength": 1,
      "title": "Ui Config File",
      "type": "string"
    },
    "baseline": {
      "$ref": "#/$defs/DeploymentFile"
    },
    "patched": {
      "$ref": "#/$defs/DeploymentFile"
    },
    "require_exact_revisions": {
      "default": true,
      "title": "Require Exact Revisions",
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "repository",
    "repository_path",
    "graph_config_file",
    "retrieval_config_file",
    "ui_config_file",
    "baseline",
    "patched"
  ],
  "title": "Application",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
