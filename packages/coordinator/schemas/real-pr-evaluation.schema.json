{
  "$defs": {
    "ExpectedClaim": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "allowed_evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Allowed Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "statement",
        "allowed_evidence_ids"
      ],
      "title": "ExpectedClaim",
      "type": "object"
    },
    "ExpectedImpact": {
      "additionalProperties": false,
      "properties": {
        "ui_elements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Ui Elements",
          "type": "array"
        },
        "flows": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Flows",
          "type": "array"
        },
        "requirements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Requirements",
          "type": "array"
        },
        "claims": {
          "additionalProperties": {
            "$ref": "#/$defs/ExpectedClaim"
          },
          "title": "Claims",
          "type": "object"
        }
      },
      "title": "ExpectedImpact",
      "type": "object"
    },
    "RealPrCase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^pr-[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "split": {
          "enum": [
            "development",
            "held_out"
          ],
          "title": "Split",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "pull_request": {
          "exclusiveMinimum": 0,
          "title": "Pull Request",
          "type": "integer"
        },
        "base_revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Base Revision",
          "type": "string"
        },
        "head_revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Head Revision",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/ExpectedImpact"
        }
      },
      "required": [
        "id",
        "split",
        "repository",
        "pull_request",
        "base_revision",
        "head_revision",
        "source_file",
        "source_sha256",
        "expected"
      ],
      "title": "RealPrCase",
      "type": "object"
    },
    "ReviewProvenance": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "DRAFT",
          "enum": [
            "DRAFT",
            "APPROVED"
          ],
          "title": "Status",
          "type": "string"
        },
        "label_author": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label Author",
          "type": "string"
        },
        "independent_reviewer": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Independent Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "notes": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "label_author",
        "notes"
      ],
      "title": "ReviewProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "review": {
      "$ref": "#/$defs/ReviewProvenance"
    },
    "minimum_relevance_precision": {
      "default": 0.8,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Relevance Precision",
      "type": "number"
    },
    "minimum_relevance_recall": {
      "default": 0.8,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Relevance Recall",
      "type": "number"
    },
    "minimum_faithfulness": {
      "default": 0.95,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Faithfulness",
      "type": "number"
    },
    "minimum_claim_recall": {
      "default": 0.8,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Claim Recall",
      "type": "number"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/RealPrCase"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "id",
    "review",
    "cases"
  ],
  "title": "Real PR relevance and faithfulness dataset",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
