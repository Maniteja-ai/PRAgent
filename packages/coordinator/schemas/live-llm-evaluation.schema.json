{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "diff",
            "graph",
            "document",
            "browser",
            "fixture",
            "verification",
            "attestation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "maxLength": 60000,
          "title": "Summary",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "project_id",
        "kind",
        "summary",
        "source"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GeminiProvider": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "gemini",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "default": "COORDINATOR_LLM_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 45,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_tokens": {
          "default": 3000,
          "maximum": 16000,
          "minimum": 256,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_input_chars": {
          "default": 120000,
          "maximum": 500000,
          "minimum": 1000,
          "title": "Max Input Chars",
          "type": "integer"
        },
        "retry_invalid_response": {
          "default": false,
          "description": "Allow the shared dispatcher to retry invalid structured output within retry_attempts and the same model.decide budget. No invalid decision is executed.",
          "title": "Retry Invalid Response",
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "GeminiProvider",
      "type": "object"
    },
    "GuardrailPolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "request_sensitive_action": {
          "default": "block",
          "enum": [
            "block",
            "allow"
          ],
          "title": "Request Sensitive Action",
          "type": "string"
        },
        "evidence_sensitive_action": {
          "default": "redact",
          "enum": [
            "redact",
            "block"
          ],
          "title": "Evidence Sensitive Action",
          "type": "string"
        },
        "prompt_injection_action": {
          "default": "quarantine",
          "enum": [
            "quarantine",
            "block"
          ],
          "title": "Prompt Injection Action",
          "type": "string"
        },
        "output_sensitive_action": {
          "const": "block",
          "default": "block",
          "title": "Output Sensitive Action",
          "type": "string"
        },
        "max_findings_per_call": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Findings Per Call",
          "type": "integer"
        }
      },
      "title": "GuardrailPolicy",
      "type": "object"
    },
    "JsonValue": {},
    "LiveExpected": {
      "additionalProperties": false,
      "properties": {
        "provider_called": {
          "title": "Provider Called",
          "type": "boolean"
        },
        "action": {
          "anyOf": [
            {
              "enum": [
                "tool",
                "review",
                "finish"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "minimum_findings": {
          "default": 0,
          "maximum": 30,
          "minimum": 0,
          "title": "Minimum Findings",
          "type": "integer"
        },
        "required_citation_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Citation Ids",
          "type": "array"
        },
        "forbidden_citation_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Forbidden Citation Ids",
          "type": "array"
        },
        "guardrail_status": {
          "enum": [
            "PASSED",
            "SANITIZED",
            "BLOCKED"
          ],
          "title": "Guardrail Status",
          "type": "string"
        }
      },
      "required": [
        "provider_called",
        "guardrail_status"
      ],
      "title": "LiveExpected",
      "type": "object"
    },
    "LiveLLMCase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        },
        "expected": {
          "$ref": "#/$defs/LiveExpected"
        }
      },
      "required": [
        "id",
        "question",
        "expected"
      ],
      "title": "LiveLLMCase",
      "type": "object"
    },
    "OpenAIProvider": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "openai",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "default": "COORDINATOR_LLM_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 45,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_tokens": {
          "default": 3000,
          "maximum": 16000,
          "minimum": 256,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_input_chars": {
          "default": 120000,
          "maximum": 500000,
          "minimum": 1000,
          "title": "Max Input Chars",
          "type": "integer"
        },
        "retry_invalid_response": {
          "default": false,
          "description": "Allow the shared dispatcher to retry invalid structured output within retry_attempts and the same model.decide budget. No invalid decision is executed.",
          "title": "Retry Invalid Response",
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "OpenAIProvider",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "env_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Env File"
    },
    "model": {
      "discriminator": {
        "mapping": {
          "gemini": "#/$defs/GeminiProvider",
          "openai": "#/$defs/OpenAIProvider"
        },
        "propertyName": "provider"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/GeminiProvider"
        },
        {
          "$ref": "#/$defs/OpenAIProvider"
        }
      ],
      "title": "Model"
    },
    "guardrails": {
      "$ref": "#/$defs/GuardrailPolicy"
    },
    "max_provider_calls": {
      "default": 5,
      "maximum": 5,
      "minimum": 1,
      "title": "Max Provider Calls",
      "type": "integer"
    },
    "minimum_case_pass_rate": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Case Pass Rate",
      "type": "number"
    },
    "minimum_structured_output_rate": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Structured Output Rate",
      "type": "number"
    },
    "minimum_grounded_finding_rate": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Grounded Finding Rate",
      "type": "number"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/LiveLLMCase"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "id",
    "model",
    "cases"
  ],
  "title": "Live LLM evaluation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
