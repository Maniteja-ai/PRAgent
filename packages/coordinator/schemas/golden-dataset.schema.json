{
  "$defs": {
    "AnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "project_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "pull_request": {
          "exclusiveMinimum": 0,
          "title": "Pull Request",
          "type": "integer"
        },
        "question": {
          "default": "Which UI flows and requirements could this PR affect?",
          "maxLength": 4000,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "repository",
        "pull_request"
      ],
      "title": "AnalysisRequest",
      "type": "object"
    },
    "CallLimits": {
      "additionalProperties": false,
      "properties": {
        "per_agent_tool": {
          "default": 5,
          "description": "Maximum executed attempts per run, stable agent identity and canonical tool. Includes failures and retries; resume never resets it.",
          "maximum": 5,
          "minimum": 1,
          "title": "Per Agent Tool",
          "type": "integer"
        },
        "overrides": {
          "additionalProperties": {
            "additionalProperties": {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            "type": "object"
          },
          "description": "Optional lower limits: agent ID -> canonical tool ID -> limit (1 to default).",
          "title": "Overrides",
          "type": "object"
        },
        "total_calls": {
          "default": 30,
          "description": "Combined tool and model attempts per run.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Total Calls",
          "type": "integer"
        },
        "max_rounds": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Rounds",
          "type": "integer"
        },
        "max_review_requests": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Review Requests",
          "type": "integer"
        },
        "max_validation_repairs": {
          "default": 1,
          "description": "Bounded citation correction turns; each consumes model.decide and round budgets.",
          "maximum": 2,
          "minimum": 0,
          "title": "Max Validation Repairs",
          "type": "integer"
        },
        "max_run_seconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Run Seconds",
          "type": "integer"
        },
        "retry_attempts": {
          "default": 2,
          "description": "Total attempts, including the first.",
          "maximum": 5,
          "minimum": 1,
          "title": "Retry Attempts",
          "type": "integer"
        },
        "retry_delay_seconds": {
          "default": 1,
          "maximum": 30,
          "minimum": 0,
          "title": "Retry Delay Seconds",
          "type": "number"
        }
      },
      "title": "CallLimits",
      "type": "object"
    },
    "DatasetReview": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "APPROVED",
          "title": "Status",
          "type": "string"
        },
        "reviewed_by": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Reviewed By",
          "type": "string"
        },
        "reviewed_at": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Reviewed At",
          "type": "string"
        },
        "basis": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reviewed_by",
        "reviewed_at",
        "basis"
      ],
      "title": "DatasetReview",
      "type": "object"
    },
    "GoldenCase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/AnalysisRequest"
        },
        "tools": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Tools",
          "type": "object"
        },
        "decisions": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Decisions",
          "type": "array"
        },
        "human_review": {
          "$ref": "#/$defs/HumanReviewPolicy"
        },
        "expected": {
          "$ref": "#/$defs/GoldenExpected"
        }
      },
      "required": [
        "id",
        "request",
        "tools",
        "decisions",
        "expected"
      ],
      "title": "GoldenCase",
      "type": "object"
    },
    "GoldenExpected": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "COMPLETED",
            "COMPLETED_WITH_GAPS",
            "STOPPED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "stop_reason": {
          "title": "Stop Reason",
          "type": "string"
        },
        "verification": {
          "default": "NOT_RUN",
          "title": "Verification",
          "type": "string"
        },
        "review_status": {
          "default": "NOT_REQUESTED",
          "enum": [
            "NOT_REQUESTED",
            "NOT_ANSWERED",
            "ANSWERED"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "review_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Question"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GoldenFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "max_total_calls": {
          "default": 30,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Total Calls",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "stop_reason"
      ],
      "title": "GoldenExpected",
      "type": "object"
    },
    "GoldenFinding": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "title",
        "evidence_ids"
      ],
      "title": "GoldenFinding",
      "type": "object"
    },
    "HumanReviewPolicy": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "default": "blocking",
          "description": "blocking checkpoints the graph until an answer arrives; non_blocking finalizes with explicit gaps and permits a linked later verification run.",
          "enum": [
            "blocking",
            "non_blocking"
          ],
          "title": "Policy",
          "type": "string"
        },
        "allow_follow_up_verification": {
          "default": true,
          "description": "Allow a later answer to an unanswered verification-approval question to create one linked run without resetting the original call ledger.",
          "title": "Allow Follow Up Verification",
          "type": "boolean"
        }
      },
      "title": "HumanReviewPolicy",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "review": {
      "$ref": "#/$defs/DatasetReview"
    },
    "limits": {
      "$ref": "#/$defs/CallLimits"
    },
    "minimum_precision": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Precision",
      "type": "number"
    },
    "minimum_recall": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Recall",
      "type": "number"
    },
    "minimum_case_pass_rate": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Case Pass Rate",
      "type": "number"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/GoldenCase"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "id",
    "review",
    "cases"
  ],
  "title": "Coordinator golden dataset",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
