{
  "$defs": {
    "CallLimits": {
      "additionalProperties": false,
      "properties": {
        "per_agent_tool": {
          "default": 5,
          "description": "Maximum executed attempts per run, stable agent identity and canonical tool. Includes failures and retries; resume never resets it.",
          "maximum": 5,
          "minimum": 1,
          "title": "Per Agent Tool",
          "type": "integer"
        },
        "overrides": {
          "additionalProperties": {
            "additionalProperties": {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            "type": "object"
          },
          "description": "Optional lower limits: agent ID -> canonical tool ID -> limit (1 to default).",
          "title": "Overrides",
          "type": "object"
        },
        "total_calls": {
          "default": 30,
          "description": "Combined tool and model attempts per run.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Total Calls",
          "type": "integer"
        },
        "max_rounds": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Rounds",
          "type": "integer"
        },
        "max_review_requests": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Review Requests",
          "type": "integer"
        },
        "max_validation_repairs": {
          "default": 1,
          "description": "Bounded citation correction turns; each consumes model.decide and round budgets.",
          "maximum": 2,
          "minimum": 0,
          "title": "Max Validation Repairs",
          "type": "integer"
        },
        "max_run_seconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Run Seconds",
          "type": "integer"
        },
        "retry_attempts": {
          "default": 2,
          "description": "Total attempts, including the first.",
          "maximum": 5,
          "minimum": 1,
          "title": "Retry Attempts",
          "type": "integer"
        },
        "retry_delay_seconds": {
          "default": 1.0,
          "maximum": 30,
          "minimum": 0,
          "title": "Retry Delay Seconds",
          "type": "number"
        }
      },
      "title": "CallLimits",
      "type": "object"
    },
    "InvalidVoucher": {
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "const": "invalid_voucher",
          "title": "Scenario",
          "type": "string"
        },
        "invalid_code": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Invalid Code",
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "invalid_code"
      ],
      "title": "InvalidVoucher",
      "type": "object"
    },
    "QuantityChange": {
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "const": "quantity_change",
          "title": "Scenario",
          "type": "string"
        },
        "voucher_code": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Voucher Code",
          "type": "string"
        },
        "initial_quantity": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Initial Quantity",
          "type": "integer"
        },
        "target_quantity": {
          "default": 2,
          "maximum": 5,
          "minimum": 2,
          "title": "Target Quantity",
          "type": "integer"
        }
      },
      "required": [
        "scenario",
        "voucher_code"
      ],
      "title": "QuantityChange",
      "type": "object"
    },
    "ShippingAddress": {
      "additionalProperties": false,
      "properties": {
        "first_name": {
          "maxLength": 50,
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Last Name",
          "type": "string"
        },
        "street_address_1": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Street Address 1",
          "type": "string"
        },
        "city": {
          "maxLength": 100,
          "minLength": 1,
          "title": "City",
          "type": "string"
        },
        "postal_code": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Postal Code",
          "type": "string"
        },
        "country": {
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        }
      },
      "required": [
        "first_name",
        "last_name",
        "street_address_1",
        "city",
        "postal_code",
        "country"
      ],
      "title": "ShippingAddress",
      "type": "object"
    },
    "ShippingPrerequisite": {
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "const": "shipping_prerequisite",
          "title": "Scenario",
          "type": "string"
        },
        "voucher_code": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Voucher Code",
          "type": "string"
        },
        "shipping_method_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Shipping Method Name",
          "type": "string"
        },
        "address": {
          "$ref": "#/$defs/ShippingAddress"
        }
      },
      "required": [
        "scenario",
        "voucher_code",
        "shipping_method_name",
        "address"
      ],
      "title": "ShippingPrerequisite",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "graphql_url": {
      "title": "Graphql Url",
      "type": "string"
    },
    "channel": {
      "minLength": 1,
      "title": "Channel",
      "type": "string"
    },
    "product_slug": {
      "minLength": 1,
      "title": "Product Slug",
      "type": "string"
    },
    "variant_name": {
      "minLength": 1,
      "title": "Variant Name",
      "type": "string"
    },
    "currency": {
      "default": "USD",
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "state_directory": {
      "title": "State Directory",
      "type": "string"
    },
    "scenario": {
      "discriminator": {
        "mapping": {
          "invalid_voucher": "#/$defs/InvalidVoucher",
          "quantity_change": "#/$defs/QuantityChange",
          "shipping_prerequisite": "#/$defs/ShippingPrerequisite"
        },
        "propertyName": "scenario"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/InvalidVoucher"
        },
        {
          "$ref": "#/$defs/QuantityChange"
        },
        {
          "$ref": "#/$defs/ShippingPrerequisite"
        }
      ],
      "title": "Scenario"
    },
    "timeout_seconds": {
      "default": 30,
      "exclusiveMinimum": 0,
      "maximum": 60,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "limits": {
      "$ref": "#/$defs/CallLimits"
    }
  },
  "required": [
    "graphql_url",
    "channel",
    "product_slug",
    "variant_name",
    "state_directory",
    "scenario"
  ],
  "title": "Additional Saleor behavior scenario",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
