{
  "additionalProperties": false,
  "description": "Neo4j inputs kept out of the application file.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "provider": {
      "const": "neo4j",
      "default": "neo4j",
      "title": "Provider",
      "type": "string"
    },
    "baseline_snapshot_file": {
      "minLength": 1,
      "title": "Baseline Snapshot File",
      "type": "string"
    },
    "patched_snapshot_file": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Patched Snapshot File"
    }
  },
  "required": [
    "baseline_snapshot_file"
  ],
  "title": "Code graph",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
