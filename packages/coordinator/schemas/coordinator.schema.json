{
  "$defs": {
    "ArtifactSecurityConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "discriminator": {
            "mapping": {
              "baseline": "#/$defs/BaselineDlp",
              "disabled": "#/$defs/DisabledDlp",
              "google_dlp": "#/$defs/GoogleDlp"
            },
            "propertyName": "provider"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DisabledDlp"
            },
            {
              "$ref": "#/$defs/BaselineDlp"
            },
            {
              "$ref": "#/$defs/GoogleDlp"
            }
          ],
          "title": "Provider"
        },
        "sensitive_action": {
          "const": "block",
          "default": "block",
          "title": "Sensitive Action",
          "type": "string"
        },
        "scanner_error_action": {
          "default": "block",
          "enum": [
            "block",
            "allow"
          ],
          "title": "Scanner Error Action",
          "type": "string"
        },
        "unsupported_action": {
          "default": "block",
          "enum": [
            "block",
            "allow"
          ],
          "title": "Unsupported Action",
          "type": "string"
        },
        "max_bytes": {
          "default": 1000000,
          "maximum": 10000000,
          "minimum": 1000,
          "title": "Max Bytes",
          "type": "integer"
        },
        "text_suffixes": {
          "default": [
            ".json",
            ".html",
            ".txt",
            ".md",
            ".diff",
            ".observation.json",
            ".transition.json",
            ".assertion.json",
            ".fixture.json",
            ".behavior.json",
            ".graph.json"
          ],
          "items": {
            "type": "string"
          },
          "title": "Text Suffixes",
          "type": "array"
        },
        "image_suffixes": {
          "default": [
            ".png",
            ".jpg",
            ".jpeg"
          ],
          "items": {
            "type": "string"
          },
          "title": "Image Suffixes",
          "type": "array"
        }
      },
      "title": "ArtifactSecurityConfig",
      "type": "object"
    },
    "BaselineDlp": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "baseline",
          "default": "baseline",
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "BaselineDlp",
      "type": "object"
    },
    "CallLimits": {
      "additionalProperties": false,
      "properties": {
        "per_agent_tool": {
          "default": 5,
          "description": "Maximum executed attempts per run, stable agent identity and canonical tool. Includes failures and retries; resume never resets it.",
          "maximum": 5,
          "minimum": 1,
          "title": "Per Agent Tool",
          "type": "integer"
        },
        "overrides": {
          "additionalProperties": {
            "additionalProperties": {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            "type": "object"
          },
          "description": "Optional lower limits: agent ID -> canonical tool ID -> limit (1 to default).",
          "title": "Overrides",
          "type": "object"
        },
        "total_calls": {
          "default": 30,
          "description": "Combined tool and model attempts per run.",
          "maximum": 1000,
          "minimum": 1,
          "title": "Total Calls",
          "type": "integer"
        },
        "max_rounds": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Rounds",
          "type": "integer"
        },
        "max_review_requests": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Review Requests",
          "type": "integer"
        },
        "max_validation_repairs": {
          "default": 1,
          "description": "Bounded citation correction turns; each consumes model.decide and round budgets.",
          "maximum": 2,
          "minimum": 0,
          "title": "Max Validation Repairs",
          "type": "integer"
        },
        "max_run_seconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Run Seconds",
          "type": "integer"
        },
        "retry_attempts": {
          "default": 2,
          "description": "Total attempts, including the first.",
          "maximum": 5,
          "minimum": 1,
          "title": "Retry Attempts",
          "type": "integer"
        },
        "retry_delay_seconds": {
          "default": 1,
          "maximum": 30,
          "minimum": 0,
          "title": "Retry Delay Seconds",
          "type": "number"
        }
      },
      "title": "CallLimits",
      "type": "object"
    },
    "DisabledDlp": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "disabled",
          "default": "disabled",
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "DisabledDlp",
      "type": "object"
    },
    "ExplorationConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "environment": {
          "default": "patched",
          "enum": [
            "baseline",
            "patched"
          ],
          "title": "Environment",
          "type": "string"
        },
        "goal": {
          "default": "Explore the UI affected by the change using observed controls.",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "target_controls": {
          "default": [],
          "description": "Stop discovery when any exact accessible control name is observed. Observation is not a behavior check.",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Target Controls",
          "type": "array"
        },
        "max_steps": {
          "default": 4,
          "description": "Maximum proposed exploration actions. Model/tool attempt limits still apply; one model attempt is reserved for reporting.",
          "maximum": 10,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_state_visits": {
          "default": 2,
          "description": "Stop when the latest meaningful screen fingerprint has been captured this many times.",
          "maximum": 5,
          "minimum": 1,
          "title": "Max State Visits",
          "type": "integer"
        }
      },
      "title": "ExplorationConfig",
      "type": "object"
    },
    "FixtureProvider": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "fixture",
          "default": "fixture",
          "title": "Provider",
          "type": "string"
        },
        "file": {
          "description": "Replay fixture, relative to this configuration file.",
          "minLength": 1,
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "FixtureProvider",
      "type": "object"
    },
    "GeminiProvider": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "gemini",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "default": "COORDINATOR_LLM_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 45,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_tokens": {
          "default": 3000,
          "maximum": 16000,
          "minimum": 256,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_input_chars": {
          "default": 120000,
          "maximum": 500000,
          "minimum": 1000,
          "title": "Max Input Chars",
          "type": "integer"
        },
        "retry_invalid_response": {
          "default": false,
          "description": "Allow the shared dispatcher to retry invalid structured output within retry_attempts and the same model.decide budget. No invalid decision is executed.",
          "title": "Retry Invalid Response",
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "GeminiProvider",
      "type": "object"
    },
    "GoogleDlp": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "google_dlp",
          "default": "google_dlp",
          "title": "Provider",
          "type": "string"
        },
        "project_id_env": {
          "default": "GOOGLE_CLOUD_PROJECT",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Project Id Env",
          "type": "string"
        },
        "location": {
          "default": "global",
          "pattern": "^[A-Za-z0-9-]{1,63}$",
          "title": "Location",
          "type": "string"
        },
        "info_types": {
          "default": [
            "PERSON_NAME",
            "EMAIL_ADDRESS",
            "PHONE_NUMBER",
            "STREET_ADDRESS",
            "CREDIT_CARD_NUMBER",
            "US_SOCIAL_SECURITY_NUMBER",
            "AUTH_TOKEN",
            "JSON_WEB_TOKEN"
          ],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Info Types",
          "type": "array"
        },
        "min_likelihood": {
          "default": "POSSIBLE",
          "enum": [
            "POSSIBLE",
            "LIKELY",
            "VERY_LIKELY"
          ],
          "title": "Min Likelihood",
          "type": "string"
        },
        "max_findings": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Findings",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 15,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "GoogleDlp",
      "type": "object"
    },
    "GuardrailPolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "request_sensitive_action": {
          "default": "block",
          "enum": [
            "block",
            "allow"
          ],
          "title": "Request Sensitive Action",
          "type": "string"
        },
        "evidence_sensitive_action": {
          "default": "redact",
          "enum": [
            "redact",
            "block"
          ],
          "title": "Evidence Sensitive Action",
          "type": "string"
        },
        "prompt_injection_action": {
          "default": "quarantine",
          "enum": [
            "quarantine",
            "block"
          ],
          "title": "Prompt Injection Action",
          "type": "string"
        },
        "output_sensitive_action": {
          "const": "block",
          "default": "block",
          "title": "Output Sensitive Action",
          "type": "string"
        },
        "max_findings_per_call": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Findings Per Call",
          "type": "integer"
        }
      },
      "title": "GuardrailPolicy",
      "type": "object"
    },
    "LiveProvider": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "live",
          "title": "Provider",
          "type": "string"
        },
        "application_file": {
          "minLength": 1,
          "title": "Application File",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "application_file"
      ],
      "title": "LiveProvider",
      "type": "object"
    },
    "OpenAIProvider": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "openai",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "default": "COORDINATOR_LLM_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 45,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_tokens": {
          "default": 3000,
          "maximum": 16000,
          "minimum": 256,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_input_chars": {
          "default": 120000,
          "maximum": 500000,
          "minimum": 1000,
          "title": "Max Input Chars",
          "type": "integer"
        },
        "retry_invalid_response": {
          "default": false,
          "description": "Allow the shared dispatcher to retry invalid structured output within retry_attempts and the same model.decide budget. No invalid decision is executed.",
          "title": "Retry Invalid Response",
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "title": "OpenAIProvider",
      "type": "object"
    },
    "ScenarioBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "config_file": {
          "description": "Approved scenario JSON, relative to coordinator JSON.",
          "minLength": 1,
          "title": "Config File",
          "type": "string"
        },
        "changed_paths": {
          "description": "Repository-relative glob patterns selecting this scenario.",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Changed Paths",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "config_file",
        "changed_paths"
      ],
      "title": "ScenarioBinding",
      "type": "object"
    },
    "VerificationPolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "approval": {
          "default": "human_review",
          "description": "Preapproved authorizes only configured scenarios; models cannot introduce new test actions.",
          "enum": [
            "human_review",
            "preapproved"
          ],
          "title": "Approval",
          "type": "string"
        },
        "scenarios": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScenarioBinding"
          },
          "maxItems": 10,
          "title": "Scenarios",
          "type": "array"
        }
      },
      "title": "VerificationPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "limits": {
      "$ref": "#/$defs/CallLimits"
    },
    "exploration": {
      "$ref": "#/$defs/ExplorationConfig"
    },
    "verification": {
      "$ref": "#/$defs/VerificationPolicy"
    },
    "guardrails": {
      "$ref": "#/$defs/GuardrailPolicy"
    },
    "artifact_security": {
      "$ref": "#/$defs/ArtifactSecurityConfig"
    },
    "model": {
      "discriminator": {
        "mapping": {
          "fixture": "#/$defs/FixtureProvider",
          "gemini": "#/$defs/GeminiProvider",
          "openai": "#/$defs/OpenAIProvider"
        },
        "propertyName": "provider"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FixtureProvider"
        },
        {
          "$ref": "#/$defs/GeminiProvider"
        },
        {
          "$ref": "#/$defs/OpenAIProvider"
        }
      ],
      "title": "Model"
    },
    "tools": {
      "discriminator": {
        "mapping": {
          "fixture": "#/$defs/FixtureProvider",
          "live": "#/$defs/LiveProvider"
        },
        "propertyName": "provider"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FixtureProvider"
        },
        {
          "$ref": "#/$defs/LiveProvider"
        }
      ],
      "title": "Tools"
    },
    "env_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional dotenv path relative to this config; never copied to reports.",
      "title": "Env File"
    },
    "state_directory": {
      "default": "../runs",
      "minLength": 1,
      "title": "State Directory",
      "type": "string"
    }
  },
  "required": [
    "model",
    "tools"
  ],
  "title": "PR impact coordinator",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
