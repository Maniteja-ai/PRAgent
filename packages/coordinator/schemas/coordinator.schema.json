{
  "$defs": {
    "FixtureProvider": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "fixture",
          "default": "fixture",
          "title": "Provider",
          "type": "string"
        },
        "file": {
          "description": "Replay fixture, relative to this configuration file.",
          "minLength": 1,
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "FixtureProvider",
      "type": "object"
    },
    "GeminiProvider": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "default": "COORDINATOR_LLM_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 45,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_tokens": {
          "default": 3000,
          "maximum": 16000,
          "minimum": 256,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_input_chars": {
          "default": 120000,
          "maximum": 500000,
          "minimum": 1000,
          "title": "Max Input Chars",
          "type": "integer"
        },
        "retry_invalid_response": {
          "default": false,
          "description": "Allow the shared dispatcher to retry invalid structured output within retry_attempts and the same model.decide budget. No invalid decision is executed.",
          "title": "Retry Invalid Response",
          "type": "boolean"
        },
        "provider": {
          "const": "gemini",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "model",
        "provider"
      ],
      "title": "GeminiProvider",
      "type": "object"
    },
    "HumanReviewPolicy": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "default": "blocking",
          "description": "blocking checkpoints the graph until an answer arrives; non_blocking finalizes with explicit gaps and permits a linked later verification run.",
          "enum": [
            "blocking",
            "non_blocking"
          ],
          "title": "Policy",
          "type": "string"
        },
        "allow_follow_up_verification": {
          "default": true,
          "description": "Allow a later answer to an unanswered verification-approval question to create one linked run without resetting the original call ledger.",
          "title": "Allow Follow Up Verification",
          "type": "boolean"
        }
      },
      "title": "HumanReviewPolicy",
      "type": "object"
    },
    "OpenAIProvider": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "default": "COORDINATOR_LLM_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 45,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_tokens": {
          "default": 3000,
          "maximum": 16000,
          "minimum": 256,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_input_chars": {
          "default": 120000,
          "maximum": 500000,
          "minimum": 1000,
          "title": "Max Input Chars",
          "type": "integer"
        },
        "retry_invalid_response": {
          "default": false,
          "description": "Allow the shared dispatcher to retry invalid structured output within retry_attempts and the same model.decide budget. No invalid decision is executed.",
          "title": "Retry Invalid Response",
          "type": "boolean"
        },
        "provider": {
          "const": "openai",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "model",
        "provider"
      ],
      "title": "OpenAIProvider",
      "type": "object"
    },
    "UIExplorationConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "environment": {
          "default": "patched",
          "enum": [
            "baseline",
            "patched"
          ],
          "title": "Environment",
          "type": "string"
        },
        "goal": {
          "default": "Explore the UI affected by the change using observed controls.",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "target_controls": {
          "default": [],
          "description": "Stop discovery when any exact accessible control name is observed. Observation is not a behavior check.",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Target Controls",
          "type": "array"
        },
        "max_steps": {
          "default": 4,
          "description": "Maximum proposed UI exploration actions. Model/tool attempt limits still apply; one model attempt is reserved for reporting.",
          "maximum": 10,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_state_visits": {
          "default": 2,
          "description": "Stop when the latest meaningful screen fingerprint has been captured this many times.",
          "maximum": 5,
          "minimum": 1,
          "title": "Max State Visits",
          "type": "integer"
        }
      },
      "title": "UIExplorationConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Small user-facing coordinator file.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "application_config_file": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Live application configuration.",
      "title": "Application Config File"
    },
    "tool_fixture_file": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Offline tool fixture used by tests and demos.",
      "title": "Tool Fixture File"
    },
    "runtime_config_file": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional calls, retries, timeouts and safety overrides.",
      "title": "Runtime Config File"
    },
    "ui_exploration": {
      "$ref": "#/$defs/UIExplorationConfig"
    },
    "verification_config_file": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional approved verification catalog.",
      "title": "Verification Config File"
    },
    "human_review": {
      "$ref": "#/$defs/HumanReviewPolicy"
    },
    "model": {
      "discriminator": {
        "mapping": {
          "fixture": "#/$defs/FixtureProvider",
          "gemini": "#/$defs/GeminiProvider",
          "openai": "#/$defs/OpenAIProvider"
        },
        "propertyName": "provider"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FixtureProvider"
        },
        {
          "$ref": "#/$defs/GeminiProvider"
        },
        {
          "$ref": "#/$defs/OpenAIProvider"
        }
      ],
      "title": "Model"
    },
    "env_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional dotenv path relative to this config; never copied to reports.",
      "title": "Env File"
    },
    "state_directory": {
      "default": "../runs",
      "minLength": 1,
      "title": "State Directory",
      "type": "string"
    }
  },
  "required": [
    "model"
  ],
  "title": "PR impact coordinator",
  "type": "object",
  "oneOf": [
    {
      "required": [
        "application_config_file"
      ],
      "not": {
        "required": [
          "tool_fixture_file"
        ]
      }
    },
    {
      "required": [
        "tool_fixture_file"
      ],
      "not": {
        "required": [
          "application_config_file"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
