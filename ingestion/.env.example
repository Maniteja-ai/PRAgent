# Local only. Never commit credentials. Aura credentials are created by you.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Use the actual database name reported by your instance; Aura may use its instance ID.
NEO4J_DATABASE=neo4j
# Optional OpenAI extraction adapter; model choice is explicit.
OPENAI_API_KEY=
INGESTION_MODEL=

# Optional bounded model settings
REQUEST_TIMEOUT=90
MODEL_RETRIES=2
MAX_OUTPUT_TOKENS=6000

# Vector indexing: select an embedding model that supports the requested dimensions.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=0
# Blank URL uses persistent local Qdrant; set URL/key for a Qdrant server.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=.vector-store

# Gemini: provider/model choices are in project JSON; only the key belongs here.
GEMINI_API_KEY=

# Optional content-safe LangSmith execution tracing for coordinator configs that enable it.
# Graph inputs/outputs remain hidden; this key is never written to reports.
LANGSMITH_API_KEY=
# Optional only for regional or self-hosted LangSmith.
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
# Keep telemetry delivery fail-open for CLI/webhook worker shutdown.
LANGSMITH_USE_DAEMON=true

# Optional separate key for LLM reranking, chosen through options.api_key_env in retrieval JSON.
# It must belong to the configured provider/endpoint. Local cross_encoder needs no key.
ENCODER_API_KEY=

# Coordinator GitHub App boundary. Keep the PEM value out of committed files.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=

# Google Sensitive Data Protection uses Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
